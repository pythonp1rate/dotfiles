;; Control center: header, WiFi/BT/Audio toggles, Notifications, Volume + Brightness sliders
;; Single defwidget to avoid eww parser issues with nested defwidgets

(defpoll user_host :interval "30s" "echo $(whoami)@$(hostname)")
(defpoll volume_level :interval "1s" "pamixer --get-volume 2>/dev/null || echo 0")
(defpoll audio_status :interval "1s" "pamixer --get-mute 2>/dev/null | grep -q true && echo Muted || echo $(pamixer --get-volume 2>/dev/null)%")
(defpoll brightness_level :interval "2s" "brightnessctl -d amdgpu_bl1 get 2>/dev/null | awk '{print int(($1/255)*100)}' || brightnessctl get 2>/dev/null | awk '{print int(($1/255)*100)}' || echo 50")
(defpoll wifi_status :interval "5s" "nmcli -t -f name con show --active 2>/dev/null | head -1 || echo Off")
(defpoll bluetooth_status :interval "5s" "bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo On || echo Off")

(defwidget control_center_panel []
  (box :class "control-center-panel"
    :orientation "vertical"
    :space-evenly false

    ;; Header: user@host + config/reload/power icons
    (box :class "cc-header"
      :orientation "horizontal"
      :space-evenly false
      (label :class "cc-user-host" :text {user_host})
      (box :class "cc-header-icons" :orientation "horizontal"
        (button :class "cc-icon-btn" :onclick "xdg-open ~/.config" "✎")
        (button :class "cc-icon-btn" :onclick "xdg-open ~/.config/hypr" "⚙")
        (button :class "cc-icon-btn" :onclick "pkill -SIGUSR1 waybar" "↻")
        (button :class "cc-icon-btn" :onclick "~/.config/rofi/scripts/powermenu/powermenu 2>/dev/null || true" "⏻")))

    ;; Quick toggles: WiFi, Bluetooth, Audio, Airplane (2x2)
    (box :class "cc-section"
      (label :class "cc-section-label" "Quick toggles")
      (box :class "cc-toggles"
      (box :class "cc-toggles-grid" :orientation "vertical"
        (box :orientation "horizontal"
          (button :class "cc-toggle" :onclick "nmcli radio wifi toggle"
            (box :orientation "vertical"
              (label :class "cc-toggle-icon" "󰖩")
              (label :class "cc-toggle-label" "WiFi")
              (label :class "cc-toggle-status" :text {wifi_status})))
          (button :class "cc-toggle" :onclick "bluetoothctl power toggle"
            (box :orientation "vertical"
              (label :class "cc-toggle-icon" "󰂯")
              (label :class "cc-toggle-label" "Bluetooth")
              (label :class "cc-toggle-status" :text {bluetooth_status}))))
        (box :orientation "horizontal"
          (button :class "cc-toggle" :onclick "pamixer -t"
            (box :orientation "vertical"
              (label :class "cc-toggle-icon" "󰕾")
              (label :class "cc-toggle-label" "Audio")
              (label :class "cc-toggle-status" :text {audio_status})))
          (button :class "cc-toggle" :onclick "true"
            (box :orientation "vertical"
              (label :class "cc-toggle-icon" "󰒭")
              (label :class "cc-toggle-label" "Airplane")
              (label :class "cc-toggle-status" "Off")))))))

    ;; Notifications button (opens swaync)
    (button :class "cc-notifications-btn"
      :onclick "swaync-client -t"
      (box :orientation "vertical"
        (label :class "cc-notifications-icon" "󰂛")
        (label :class "cc-notifications-label" "Notifications")))

    ;; Volume + Brightness sliders
    (box :class "cc-section"
      (label :class "cc-section-label" "Volume & brightness")
      (box :class "cc-sliders"
      (box :class "cc-slider-row"
        (label :class "cc-slider-icon" "󰕾")
        (scale :class "cc-volume-slider"
          :orientation "horizontal"
          :min 0
          :max 100
          :length 180
          :value {volume_level}
          :onchange "pamixer --set-volume {}")
        (label :class "cc-slider-pct" :text {volume_level}))
      (box :class "cc-slider-row"
        (label :class "cc-slider-icon" "󰃠")
        (scale :class "cc-brightness-slider"
          :orientation "horizontal"
          :min 1
          :max 100
          :length 180
          :value {brightness_level}
          :onchange "brightnessctl -d amdgpu_bl1 set {}% 2>/dev/null || brightnessctl set {}%")
        (label :class "cc-slider-pct" :text {brightness_level}))))))
