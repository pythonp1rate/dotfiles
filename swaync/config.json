{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "layer-shell": true,
  "cssPriority": "user",
  "layer-shell-cover-screen": false,
  "positionX": "right",
  "positionY": "top",
  "output": "HDMI-A-1",
  "layer": "overlay",
  "control-center-layer": "top",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 24,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-icon-size": 100,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "enable-notification-window": false,
  "timeout": 0,
  "timeout-low": 0,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 450,
  "control-center-height": 1200,
  "notification-window-height": 400,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "text-empty": "",
  "widgets": [ 
    "label",
    "buttons-grid#header",
    "buttons-grid#quicktoggles",
    "buttons-grid#power",
    "buttons-grid#shutdown",
    "title",
    "notifications",
    "mpris"
  ],
  "widget-config": {
    "title": {
      "text": "",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "label": {
      "max-lines": 1,
      "text": "mads@archlinux"
    },
    "buttons-grid#header": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "\uf040",
          "type": "normal",
          "command": "kitty nano /home/mads/.config/swaync/config.json",
          "tooltip": "Edit swaync config"
        },
        {
          "label": "\uf013",
          "type": "normal",
          "command": "xdg-open /home/mads/.config/swaync",
          "tooltip": "Open swaync folder"
        },
        {
          "label": "\uf021",
          "type": "normal",
          "command": "killall swaync 2>/dev/null; swaync &",
          "tooltip": "Restart swaync"
        },
        {
          "label": "\uf2f5",
          "type": "normal",
          "command": "hyprctl dispatch exit",
          "tooltip": "Log out"
        }
      ]
    },
    "notifications": {
      "vexpand": true
    },
    "buttons-grid#quicktoggles": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "\uf1eb",
          "type": "toggle",
          "active": false,
          "command": "~/.config/swaync/scripts/wifi-toggle",
          "tooltip": "Toggle WiFi"
        },
        {
          "label": "\uf293",
          "type": "toggle",
          "active": false,
          "command": "~/.config/swaync/scripts/bluetooth-toggle",
          "tooltip": "Toggle Bluetooth"
        },
        {
          "label": "\uf028",
          "type": "toggle",
          "active": false,
          "command": "~/.config/swaync/scripts/mute-toggle",
          "tooltip": "Toggle Mute"
        },
        {
          "label": "\uf072",
          "type": "toggle",
          "active": false,
          "command": "~/.config/swaync/scripts/airplane-toggle",
          "tooltip": "Toggle Airplane Mode"
        }
      ]
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 8
    },
    "buttons-grid#power": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "\uf0f3",
          "type": "dnd",
          "tooltip": "Do Not Disturb"
        },
        {
          "label": "\uf023",
          "type": "normal",
          "command": "hyprlock",
          "tooltip": "Lock Screen"
        },
        {
          "label": "\uf186",
          "type": "normal",
          "command": "systemctl suspend",
          "tooltip": "Suspend"
        },
        {
          "label": "\uf01e",
          "type": "normal",
          "command": "systemctl reboot",
          "tooltip": "Reboot"
        }
      ]
    },
    "buttons-grid#shutdown": {
      "buttons-per-row": 1,
      "actions": [
        {
          "label": "\uf011",
          "type": "normal",
          "command": "systemctl poweroff"
        }
      ]
    }
  },
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "notification-visibility": {
    "ignore-network-adapter": {
      "state": "ignored",
      "summary": "Network adapter"
    }
  }
}