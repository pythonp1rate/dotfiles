{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "layer-shell": true,
  "cssPriority": "user",
  "layer-shell-cover-screen": false,
  "positionX": "right",
  "positionY": "top",
  "output": "HDMI-A-1",
  "layer": "overlay",
  "control-center-layer": "top",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 24,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-icon-size": 100,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "enable-notification-window": false,
  "timeout": 0,
  "timeout-low": 0,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 450,
  "control-center-height": 1200,
  "notification-window-height": 400,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "",
  "widgets": [ 
    "label",
    "buttons-grid#header",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "label": {
      "max-lines": 1,
      "text": "mads@archlinux"
    },
    "buttons-grid#header": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "\uf040",
          "type": "normal",
          "command": "kitty nano /home/mads/.config/swaync/config.json"
        },
        {
          "label": "\uf013",
          "type": "normal",
          "command": "xdg-open /home/mads/.config/swaync"
        },
        {
          "label": "\uf021",
          "type": "normal",
          "command": "killall swaync 2>/dev/null; swaync &"
        },
        {
          "label": "\uf2f5",
          "type": "normal",
          "command": "hyprctl dispatch exit"
        }
      ]
    },
    "notifications": {
      "vexpand": true
    }
  },
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "notification-visibility": {
    "ignore-network-adapter": {
      "state": "ignored",
      "summary": "Network adapter"
    }
  }
}